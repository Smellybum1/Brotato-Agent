# Local / derived game material (never commit)
local_game/
backups/
runs/*
!runs/.gitkeep
!runs/summaries/
runs/summaries/*
!runs/summaries/.gitkeep
tools/**/bin/
tools/**/download/
tools/godot/
tools/gdre/
*.pck
*.exe
*.dll
*.so
*.dylib

# Python
.tmp/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
tests/fixtures/_tmp/*/
.mypy_cache/
*.egg-info/
dist/
build/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Secrets / local env
.env
.env.*
!.env.example

# Large / generated reports may retain summaries
reports/raw/
reports/*.jsonl
!reports/.gitkeep

# Combat observation dataset shards (large NPZ, never committed;
# manifest.json + reports/wp2 report are small and ARE tracked)
datasets/**/*.npz

# Deploy markers
.deploy_stamp
*.log
